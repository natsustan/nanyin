 const DOWNLOAD_STATUS_POISON_MSG: &str = "audio download status mutex should not be poisoned";
+static ACTIVE_STREAM_READ_WAITS: AtomicUsize = AtomicUsize::new(0);
+
+/// Number of streaming readers currently blocked waiting for a downloaded range.
+pub fn active_stream_read_waits() -> usize {
+    ACTIVE_STREAM_READ_WAITS.load(Ordering::Relaxed)
+}
+
+struct ActiveStreamReadWait;
+
+impl ActiveStreamReadWait {
+    fn begin() -> Self {
+        ACTIVE_STREAM_READ_WAITS.fetch_add(1, Ordering::Relaxed);
+        Self
+    }
+}
+
+impl Drop for ActiveStreamReadWait {
+    fn drop(&mut self) {
+        ACTIVE_STREAM_READ_WAITS.fetch_sub(1, Ordering::Relaxed);
+    }
+}
 
